# Open-Coder Indexer Configuration
# Copy this file to .env and fill in your actual values

OPENAI_API_KEY=openai-key
OPENAI_BASE_URL=https://base-url/api/v1
OPENAI_MODEL=gpt-5-pro


# Embedding Service Configuration
EMBEDDING_BASE_URL=https://your-embedding-endpoint.openai.com/openai/v1
EMBEDDING_API_KEY=your-embedding-api-key-here
EMBEDDING_MODEL=text-embedding-3-small

# Summary Service Configuration  
SUMMARY_BASE_URL=https://your-summary-endpoint.openai.com/openai/v1
SUMMARY_API_KEY=your-summary-api-key-here
SUMMARY_MODEL=gpt-4o-mini

# Qdrant Vector Database Configuration
QDRANT_HOST=localhost
QDRANT_PORT=6334

# Chunking Configuration
CHUNK_SIZE=100
CHUNK_OVERLAP=10

# Vector Dimensions
VECTOR_DIMENSIONS=1536
